# Telegram BotFather'dan alınan token
BOT_TOKEN=

# Mesajın gideceği sohbet ID (kullanıcı veya grup)
CHAT_ID=

# Tarama döngüsü (saniye); minimum 60
SCAN_INTERVAL_SECONDS=900

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Veri kaynağı: yahoo (varsayılan, canlı) | mock (fallback/test) | future_real
DATA_SOURCE=yahoo
# Geriye dönük uyumluluk için bırakıldı; ana seçim DATA_SOURCE ile yapılır.
FETCHER_TYPE=yahoo

# Strateji ve takip timeframe'leri
PRIMARY_TIMEFRAME=4H
TRACKING_TIMEFRAME=15m

# Sinyal kalite filtreleri
ENTRY_DISTANCE_THRESHOLD_PCT=0.03
MIN_RR=1.5

# WATCH setup zaman asimi
WATCH_EXPIRY_HOURS=48
BREAKEVEN_ON_TP1=True

# Piyasa takvimi
MARKET_TIMEZONE=Europe/Istanbul
ENABLE_DEBUG_LOGS=True

# İsteğe bağlı: durum dosyası yolu
# SIGNAL_STATE_PATH=data/signal_state.json

# Takip listesi — virgülle ayır, boşluk önemsiz, büyük/küçük harf fark etmez
# Boş bırakılırsa market/symbols.py'deki liste kullanılır (tek gerçek kaynak).
# WATCHLIST=ASELS,KATMR,EKGYO,THYAO,KCHOL,MPARK,TOASO

# Strateji v4 botu
# Gerçek bildirim moduna geçmeden önce false yapma
PAPER_MODE=true
# Pozisyon hesabı için portföy büyüklüğü (TL)
PORTFOLIO_TRY=100000

# Gün içi ön sinyal saatleri (S1..S4) ve gün sonu kapanış işi
SCAN_TIMES=10:30,12:00,14:00,16:00,17:30
CLOSE_TIME=18:45
# Yarım günde kapanış işi: resmi kapanış 12:40 + 45 dk veri gecikmesi
HALF_DAY_CLOSE_TIME=13:25
# Her sorgudan sonra tek satır özet gönderilsin mi
SCAN_SUMMARY=true
# Pazar incelemesi (her Pazar ek AI maliyeti çıkarır)
SUNDAY_REVIEW=false
SUNDAY_TIME=20:00

# Eminlik skoru: 0,4 x kural skoru + 0,6 x AI olasılığı
# Kullanıcıya AL yalnızca DÖRT koşul sağlanırsa gider:
#   kural >= 70 (StrategyConfig.buy_score), AI karari AL,
#   AI olasiligi >= AI_MIN_OLASILIK, eminlik >= MIN_EMINLIK
MIN_EMINLIK=75
AI_MIN_OLASILIK=70
EMINLIK_W_KURAL=0.4
EMINLIK_W_AI=0.6
# ALMA kararları da kısa mesajla gelsin mi (varsayılan: hayır, gölgede izlenir)
NOTIFY_ALMA=false

# AI analisti
AI_ENABLED=true
# Doğrulandı (platform.claude.com/docs, Kasım 2026):
#   claude-haiku-5-5  : <=100k token promptta 0,10 / 0,50 USD per MTok
#                       100k uzerinde 5 kati (0,50 / 2,50)
#   claude-sonnet-5-5 : 2 / 10 USD per MTok
#   web arama         : 10 USD / 1.000 arama = 0,01 USD/arama
AI_MODEL=claude-haiku-5-5
# Sesli/yazılı sohbet asistanı ayrı seçilebilir
AI_CHAT_MODEL=claude-haiku-5-5
AI_MAX_SEARCHES=2
AI_MAX_TOKENS=800
AI_MAX_COST_PER_REVIEW_USD=0.05
AI_MONTHLY_BUDGET_USD=5
AI_INPUT_USD_PER_MTOK=0.10
AI_OUTPUT_USD_PER_MTOK=0.50
AI_SEARCH_USD=0.01
# AI'ın haber araması yapabileceği alan adları
# AI_ALLOWED_DOMAINS=kap.org.tr,bigpara.hurriyet.com.tr,fintables.com,bloomberght.com,aa.com.tr

# API anahtarları
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Kurulu izleme listesi ilk açılışta buradan alınır, sonra /izle ve /birak ile yönetilir
# BORLEASE diye bir sembol yok; doğrusu BORLS
# WATCHLIST=ASELS,PAHOL,VAKFN,BORLS,EFOR,SMRVA,NTGAZ,INDES,FROTO
